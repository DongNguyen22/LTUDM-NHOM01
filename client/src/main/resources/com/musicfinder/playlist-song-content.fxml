<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.shape.Rectangle?>

<!-- Assign fx:controller when the playlist song controller is ready. -->
<VBox xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1" stylesheets="@css/playlist-song.css" spacing="26" styleClass="playlist-song-page" fx:controller="com.musicfinder.controller.playlist_songController">
    <padding>
        <Insets top="32" right="36" bottom="40" left="36"/>
    </padding>
    <Button fx:id="backButton" text="My playlists" graphicTextGap="10" styleClass="playlist-back">
        <graphic>
            <SVGPath content="M12 6H2 M6 2L2 6l4 4" styleClass="playlist-outline-icon"/>
        </graphic>
    </Button>

    <!-- <HBox alignment="CENTER_RIGHT">
        <Region HBox.hgrow="ALWAYS"/>
        <TextField fx:id="searchField" promptText="Search playlist songs..." prefWidth="280" styleClass="playlist-song-search"/>
    </HBox> -->

    <HBox spacing="28" alignment="CENTER_LEFT" styleClass="playlist-hero">
        <StackPane minWidth="180" prefWidth="180" maxWidth="180" minHeight="180" prefHeight="180" maxHeight="180" styleClass="playlist-cover-frame">
            <ImageView fx:id="playlistCover" fitWidth="180" fitHeight="180" preserveRatio="false" smooth="true">
                <image>
                    <Image url="@assets/cover-blue-flower.png"/>
                </image>
                <clip>
                    <Rectangle width="180" height="180" arcWidth="16" arcHeight="16"/>
                </clip>
            </ImageView>
        </StackPane>
        <VBox spacing="15" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS" minWidth="0">
            <Label text="YOUR PLAYLIST" styleClass="playlist-eyebrow"/>
            <Label fx:id="playlistNameLabel" text="Chill Music" wrapText="true" styleClass="playlist-detail-title"/>
            <Label fx:id="playlistDescriptionLabel" text="Slow down and let the music play." wrapText="true" styleClass="playlist-description"/>
            <Label fx:id="songCountLabel" text="0 songs" styleClass="playlist-metadata"/>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button fx:id="playAllButton" text="Play all" graphicTextGap="10" styleClass="playlist-play-all">
                    <graphic>
                        <SVGPath content="M1 0L9 5 1 10z" styleClass="playlist-play-icon"/>
                    </graphic>
                </Button>
                <Button fx:id="editPlaylistButton" text="Edit playlist" graphicTextGap="10" styleClass="playlist-edit-button">
                    <graphic>
                        <SVGPath content="M2 9l7-7 3 3-7 7H2z M8 3l3 3" styleClass="playlist-outline-icon"/>
                    </graphic>
                </Button>
                <Button fx:id="deletePlaylistButton" accessibleText="Delete playlist" styleClass="playlist-delete-button">
                    <tooltip>
                        <Tooltip text="Delete playlist"/>
                    </tooltip>
                    <graphic>
                        <SVGPath content="M1 3h12 M5 3V1h4v2 M2 3l1 11h8l1-11 M5 6v5 M9 6v5" styleClass="playlist-outline-icon"/>
                    </graphic>
                </Button>
                <HBox alignment="CENTER_RIGHT">
                    <Region HBox.hgrow="ALWAYS"/>
                    <TextField fx:id="searchField" promptText="Search playlist songs..." prefWidth="280" styleClass="playlist-song-search"/>
                </HBox>
            </HBox>
        </VBox>
    </HBox>

    <Label fx:id="playlistMessageLabel" text="" wrapText="true" visible="false" managed="false" styleClass="playlist-detail-message"/>



    <VBox fx:id="songTable" styleClass="playlist-song-table" VBox.vgrow="ALWAYS" minHeight="0">
        <!-- Fixed column widths match createSongRow(); SONG fills the remaining space. -->
        <HBox spacing="12" alignment="CENTER_LEFT" styleClass="playlist-song-header">
            <Label text="#" minWidth="28" prefWidth="28" maxWidth="28" styleClass="playlist-column-label"/>
            <Label text="SONG" minWidth="0" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="playlist-column-label"/>
            <Label text="ARTISTS" minWidth="155" prefWidth="155" maxWidth="155" styleClass="playlist-column-label"/>
            <Label text="DURATION" minWidth="75" prefWidth="75" maxWidth="75" styleClass="playlist-column-label"/>
            <Label text="ACTIONS" minWidth="120" prefWidth="120" maxWidth="120" styleClass="playlist-column-label"/>
        </HBox>
        <!-- Add song rows here from the controller. -->
        <ScrollPane fx:id="playlistScroll" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" minHeight="0" prefHeight="280" VBox.vgrow="ALWAYS" styleClass="playlist-song-scroll">
            <content>
                <VBox fx:id="songList" spacing="0" styleClass="playlist-song-list"/>
            </content>
        </ScrollPane>
    </VBox>
</VBox>
