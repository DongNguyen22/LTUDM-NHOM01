<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.musicfinder.controller.ProfileController"
            stylesheets="@../css/profile.css" fitToWidth="true" hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED" styleClass="profile-scroll">
    <content>
        <VBox alignment="TOP_LEFT" fillWidth="true" styleClass="profile-page">
            <padding><Insets top="24" right="24" bottom="28" left="24"/></padding>
            <VBox spacing="18" maxWidth="Infinity" fillWidth="true">
                <VBox spacing="8">
                    <Label text="ACCOUNT SETTINGS" styleClass="profile-eyebrow"/>
                    <Label text="My profile" styleClass="profile-title"/>
                    <Label text="Your profile and security, all in one place." wrapText="true" styleClass="profile-muted"/>
                </VBox>
                <Label fx:id="profileMessageLabel" text="" wrapText="true" styleClass="profile-message"/>
                <VBox spacing="0" styleClass="profile-card">
                    <HBox spacing="28" alignment="CENTER_LEFT" styleClass="profile-hero">
                        <StackPane minWidth="120" prefWidth="120" maxWidth="120" minHeight="120" prefHeight="120" maxHeight="120" styleClass="profile-avatar">
                            <Label fx:id="avatarInitialsLabel" text="♪" styleClass="profile-avatar-text"/>
                            <ImageView fx:id="avatarImageView" fitWidth="120" fitHeight="120" preserveRatio="false" mouseTransparent="true">
                                <clip><Circle centerX="60" centerY="60" radius="58"/></clip>
                            </ImageView>
                        </StackPane>
                        <VBox spacing="9" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS" minWidth="0">
                            <Label text="MUSIC FINDER" styleClass="profile-eyebrow"/>
                            <Label fx:id="fullNameLabel" text="Your full name" wrapText="true" styleClass="profile-name"/>
                            <Label text="Personal account" wrapText="true" styleClass="profile-muted"/>
                            <Button fx:id="chooseAvatar" visible="false" managed="false"  text="Chọn ảnh đại diện" onAction="#handleChooseAvatar" styleClass="profile-secondary-button"/>
                        </VBox>
                    </HBox>
                    <VBox spacing="18" styleClass="profile-card-body">
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label text="Personal information" styleClass="profile-section-title" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            <VBox spacing="8" alignment="TOP_RIGHT">
                                <Button fx:id="editProfileButton" text="Edit profile" onAction="#handleEditProfile" styleClass="profile-secondary-button"/>
                                <Button fx:id="saveChangesButton" text="Save changes" styleClass="profile-primary-button"/>
                            </VBox>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="16" styleClass="profile-detail-row">
                            <Label text="Full name" minWidth="110" styleClass="profile-field-label"/>
                            <Label fx:id="fullNameValueLabel" text="Not updated yet" wrapText="true" styleClass="profile-value" HBox.hgrow="ALWAYS"/>
                            <TextField fx:id="fullNameField" promptText="Enter full name" visible="false" managed="false" styleClass="profile-password-field" HBox.hgrow="ALWAYS"/>
                        </HBox>
                        <Separator styleClass="profile-divider"/>
                        <HBox alignment="CENTER_LEFT" spacing="16" styleClass="profile-detail-row">
                            <Label text="Email address" minWidth="110" styleClass="profile-field-label"/>
                            <Label fx:id="emailLabel" text="Not updated yet" wrapText="true" styleClass="profile-value" HBox.hgrow="ALWAYS"/>
                            <TextField fx:id="emailField" promptText="Enter email address" visible="false" managed="false" styleClass="profile-password-field" HBox.hgrow="ALWAYS"/>
                        </HBox>
                    </VBox>
                </VBox>
                <VBox spacing="16" styleClass="profile-card, profile-card-body">
                    <VBox spacing="6">
                        <Label text="Account security" styleClass="profile-section-title"/>
                        <Label text="Enter your current password and choose a new one." wrapText="true" styleClass="profile-muted"/>
                    </VBox>
                    <VBox spacing="9">
                        <Label text="Current password" styleClass="profile-field-label"/>
                        <PasswordField fx:id="currentPasswordField" promptText="Enter current password" styleClass="profile-password-field"/>
                    </VBox>
                    <VBox spacing="9">
                        <Label text="New password" styleClass="profile-field-label"/>
                        <PasswordField fx:id="newPasswordField" promptText="Enter new password" styleClass="profile-password-field"/>
                    </VBox>
                    <HBox alignment="CENTER_RIGHT">
                        <Button text="Change password" onAction="#handleChangePassword" styleClass="profile-primary-button"/>
                    </HBox>
                </VBox>
            </VBox>
        </VBox>
    </content>
</ScrollPane>

