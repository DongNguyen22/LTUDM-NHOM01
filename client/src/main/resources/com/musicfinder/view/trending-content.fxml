<?xml version='1.0' encoding='UTF-8'?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.Group?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.musicfinder.controller.TrendingController" stylesheets="@../css/trending.css" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="content-scroll">
    <content>
        <VBox spacing="20" styleClass="page-content">
            <padding><Insets top="34" right="36" bottom="36" left="36"/></padding>

            <!-- Header -->
            <VBox spacing="5">
                <Label text="EXPLORE / THE NUMBERS" styleClass="eyebrow"/>
                <Label text="Trending music" styleClass="page-title"/>
                <Label text="The songs and artists everyone is talking about." styleClass="page-subtitle"/>
            </VBox>

            <Label fx:id="trendingMessageLabel" text="" styleClass="trending-message"/>

            <!-- Stat cards -->
            <GridPane hgap="18">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                </columnConstraints>
                <VBox GridPane.columnIndex="0" spacing="6" maxWidth="Infinity" styleClass="stat-card">
                    <StackPane prefWidth="38" prefHeight="38" maxWidth="38" maxHeight="38" styleClass="stat-icon, stat-icon-purple">
                        <Group scaleX="0.68" scaleY="0.68"><SVGPath content="M9 18V5l12-2v13 M9 18a3 3 0 1 1-6 0 3 3 0 0 1 6 0z M21 16a3 3 0 1 1-6 0 3 3 0 0 1 6 0z" styleClass="stat-svg"/></Group>
                    </StackPane>
                    <Label text="MOST SEARCHED SONG" styleClass="metric-label">
                        <VBox.margin><Insets top="10"/></VBox.margin>
                    </Label>
                    <Label fx:id="topSongTitleLabel" text="—" styleClass="metric-title"/>
                    <Label fx:id="topSongSubtitleLabel" text="" styleClass="metric-subtitle"/>
                </VBox>

                <VBox GridPane.columnIndex="1" spacing="6" maxWidth="Infinity" styleClass="stat-card">
                    <StackPane prefWidth="38" prefHeight="38" maxWidth="38" maxHeight="38" styleClass="stat-icon, stat-icon-pink">
                        <Group scaleX="0.68" scaleY="0.68"><SVGPath content="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2 M12 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8z" styleClass="stat-svg, stat-svg-pink"/></Group>
                    </StackPane>
                    <Label text="MOST SEARCHED ARTIST" styleClass="metric-label">
                        <VBox.margin><Insets top="10"/></VBox.margin>
                    </Label>
                    <Label fx:id="topArtistTitleLabel" text="—" styleClass="metric-title"/>
                    <Label fx:id="topArtistSubtitleLabel" text="" styleClass="metric-subtitle"/>
                </VBox>
            </GridPane>

            <GridPane hgap="18" vgap="18">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                </columnConstraints>

                <!-- Top searched songs -->
                <VBox GridPane.columnIndex="0" GridPane.rowIndex="0" spacing="4" styleClass="panel-card">
                    <Label text="Top searched songs" styleClass="panel-title"/>
                    <Label text="Most popular this week" styleClass="panel-subtitle"/>
                    <!-- Mỗi dòng: HBox.bar-row [rank-number | bar-name | StackPane bar-track > bar-fill | bar-value] -->
                    <VBox fx:id="topSongsBox" spacing="2" styleClass="bar-list"/>
                </VBox>

                <!-- Top artists (thay cho Search trends) -->
                <VBox GridPane.columnIndex="1" GridPane.rowIndex="0" spacing="4" styleClass="panel-card">
                    <Label text="Top artists" styleClass="panel-title"/>
                    <Label text="Most searched artists this week" styleClass="panel-subtitle"/>
                    <VBox fx:id="topArtistsBox" spacing="2" styleClass="bar-list"/>
                </VBox>
            </GridPane>
        </VBox>
    </content>
</ScrollPane>
